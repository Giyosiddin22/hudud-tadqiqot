# Copy this file to ".env" (same folder) and fill in your real key.
# Never commit the real ".env" file.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
PORT=8080
# Any long random string — used to sign admin login session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "production" only on a real deployment behind HTTPS — this makes
# session cookies HTTPS-only. Leave unset for local development.
NODE_ENV=

# Set to "1" only if a real reverse proxy (nginx/Caddy/etc) sits in front of
# this server in production. Leave unset otherwise.
TRUST_PROXY=

# With a Render persistent disk mounted at /var/data, set DATA_DIR=/var/data.
# Leave blank for local development (server/data).
DATA_DIR=
RESPONSE_RATE_LIMIT=30
